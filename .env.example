# A template for a deployment's environment, not a file the client reads itself.
# Copy to `.env` (ignored by git) and edit. Never commit a real key or token.

# --- the service -------------------------------------------------------------
# The service as this container reaches it. On a compose network this is the service name;
# it is not the public hostname, and it is not sent through the tunnel.
API_BASE_URL=http://service:8001

# --- the loop ----------------------------------------------------------------
# serve (the miner) or verify (one verifying operator).
MINER_MODE=serve
MINER_HOME=/home/miner/.cache/agents-fyi-miner
MINER_BUDGET=24
MINER_REPORT_BUDGET=1
# How many packages the watchlist holds. It has to outlast the work; past ~4,000 the breadth
# seed stops fitting in the service's request body.
MINER_TOP=3000
# python, ruby, or both. A deployment collecting gems sets ruby; the public corpus has worked
# one index at a time while the other was paused.
MINER_ECOSYSTEMS=ruby
# 0 is no self-imposed limit. The service's quota is the authority.
MINER_WRITES_PER_HOUR=0
MINER_WORKERS=6
# 0 is no ceiling. It bounds how many installs download at once, not the rate of one.
MINER_DOWNLOAD_MBPS=0
MINER_LOG_LEVEL=INFO

# --- a verifier --------------------------------------------------------------
# Set MINER_MODE=verify, give the verifier its own home, and choose a role.
# VERIFIER_ROLE=as-reported
# VERIFIER_BUDGET=6
